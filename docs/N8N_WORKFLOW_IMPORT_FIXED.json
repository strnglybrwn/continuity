    {
      "parameters": {
        "jsCode": "const groups = new Map();\n\nfor (const item of $input.all()) {\n  const payload = item.json || {};\n  const eventId = payload.event_id;\n\n  if (!eventId) {\n    continue;\n  }\n\n  if (!groups.has(eventId)) {\n    const base = { ...payload };\n    delete base.__has_attachment;\n    delete base.attachment;\n\n    groups.set(eventId, {\n      json: base,\n      binary: {}\n    });\n  }\n\n  const group = groups.get(eventId);\n  const meta = payload.attachment || {};\n  const binaryEntries = Object.entries(item.binary || {});\n\n  for (const [sourceKey, downloaded] of binaryEntries) {\n    const attachmentCount = Object.keys(group.binary).length + 1;\n    const key = `attachment_${attachmentCount}`;\n\n    group.binary[key] = {\n      ...downloaded,\n      fileName: meta.filename || downloaded.fileName || sourceKey || key,\n      mimeType: meta.content_type || downloaded.mimeType || 'application/octet-stream'\n    };\n  }\n}\n\nreturn Array.from(groups.values()).map((entry) => {\n  if (Object.keys(entry.binary).length === 0) {\n    return { json: entry.json };\n  }\n\n  return entry;\n});"
      },
