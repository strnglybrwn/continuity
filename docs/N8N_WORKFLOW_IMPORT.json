{
  "name": "Continuity MVP - Reminder Dispatch",
  "active": false,
  "nodes": [
    {
      "id": "1",
      "name": "Trigger - Every 5 Minutes",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        240,
        300
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 5
            }
          ]
        }
      }
    },
    {
      "id": "2",
      "name": "HTTP - Evaluate Due Heartbeats",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        500,
        300
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000,
      "parameters": {
        "method": "POST",
        "url": "https://continuity.boardmad.com/heartbeat-events/evaluate-due",
        "options": {
          "timeout": 30000
        }
      }
    },
    {
      "id": "3",
      "name": "HTTP - List Pending Events",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        760,
        300
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000,
      "parameters": {
        "method": "GET",
        "url": "https://continuity.boardmad.com/heartbeat-events/pending",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "limit",
              "value": "100"
            }
          ]
        },
        "options": {
          "timeout": 30000
        }
      }
    },
    {
      "id": "4",
      "name": "Code - Expand Event Array",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1020,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const items = $input.all();\nconst expanded = [];\n\nfor (const item of items) {\n  if (Array.isArray(item.json)) {\n    for (const event of item.json) {\n      expanded.push({ json: event });\n    }\n  } else {\n    expanded.push({ json: item.json });\n  }\n}\n\nreturn expanded;"
      }
    },
    {
      "id": "5",
      "name": "Switch - Route By Event Type",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3.2,
      "position": [
        1260,
        300
      ],
      "parameters": {
        "mode": "rules",
        "rules": {
          "values": [
            {
              "conditions": {
                "conditions": [
                  {
                    "leftValue": "={{$json.event_type}}",
                    "rightValue": "reminder_due",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "reminder_due"
            },
            {
              "conditions": {
                "conditions": [
                  {
                    "leftValue": "={{$json.event_type}}",
                    "rightValue": "overdue",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "overdue"
            },
            {
              "conditions": {
                "conditions": [
                  {
                    "leftValue": "={{$json.event_type}}",
                    "rightValue": "escalation_due",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "escalation_due"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "6a",
      "name": "HTTP - Prepare Reminder Payload",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1520,
        140
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000,
      "parameters": {
        "method": "POST",
        "url": "https://continuity.boardmad.com/heartbeat-events/{{ $json.id }}/prepare-reminder",
        "options": {
          "timeout": 30000
        }
      }
    },
    {
      "id": "6b",
      "name": "HTTP - Prepare Overdue-Warning Payload",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1520,
        300
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000,
      "parameters": {
        "method": "POST",
        "url": "https://continuity.boardmad.com/heartbeat-events/{{ $json.id }}/prepare-overdue",
        "options": {
          "timeout": 30000
        }
      }
    },
    {
      "id": "6c",
      "name": "HTTP - Prepare Escalation Payload",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1520,
        460
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000,
      "parameters": {
        "method": "POST",
        "url": "https://continuity.boardmad.com/heartbeat-events/{{ $json.id }}/prepare-escalation",
        "options": {
          "timeout": 30000
        }
      }
    },
    {
      "id": "6d",
      "name": "Code - Expand Escalation Attachments",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1760,
        460
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const expanded = [];\n\nfor (const item of $input.all()) {\n  const payload = item.json || {};\n  const attachments = Array.isArray(payload.attachments) ? payload.attachments : [];\n\n  if (attachments.length === 0) {\n    expanded.push({\n      json: {\n        ...payload,\n        __has_attachment: 'false'\n      }\n    });\n    continue;\n  }\n\n  for (const attachment of attachments) {\n    expanded.push({\n      json: {\n        ...payload,\n        __has_attachment: 'true',\n        attachment\n      }\n    });\n  }\n}\n\nreturn expanded;"
      }
    },
    {
      "id": "6e",
      "name": "Switch - Escalation Attachment Path",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3.2,
      "position": [
        2000,
        460
      ],
      "parameters": {
        "mode": "rules",
        "rules": {
          "values": [
            {
              "conditions": {
                "conditions": [
                  {
                    "leftValue": "={{$json.__has_attachment}}",
                    "rightValue": "true",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "download"
            },
            {
              "conditions": {
                "conditions": [
                  {
                    "leftValue": "={{$json.__has_attachment}}",
                    "rightValue": "false",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "direct"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "6f",
      "name": "HTTP - Download Escalation Attachment",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2260,
        380
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000,
      "parameters": {
        "method": "GET",
        "url": "https://continuity.boardmad.com{{ $json.attachment.content_url_path }}",
        "responseFormat": "file",
        "options": {
          "timeout": 30000
        }
      }
    },
    {
      "id": "6g",
      "name": "Code - Assemble Escalation Email Payload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2520,
        460
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const groups = new Map();\n\nfor (const item of $input.all()) {\n  const payload = item.json || {};\n  const eventId = payload.event_id;\n\n  if (!eventId) {\n    continue;\n  }\n\n  if (!groups.has(eventId)) {\n    const base = { ...payload };\n    delete base.__has_attachment;\n    delete base.attachment;\n\n    groups.set(eventId, {\n      json: base,\n      binary: {}\n    });\n  }\n\n  const group = groups.get(eventId);\n  const downloaded = item.binary?.data;\n\n  if (downloaded) {\n    const attachmentCount = Object.keys(group.binary).length + 1;\n    const key = `attachment_${attachmentCount}`;\n    const meta = payload.attachment || {};\n\n    group.binary[key] = {\n      ...downloaded,\n      fileName: meta.filename || downloaded.fileName || key,\n      mimeType: meta.content_type || downloaded.mimeType || 'application/octet-stream'\n    };\n  }\n}\n\nreturn Array.from(groups.values()).map((entry) => {\n  if (Object.keys(entry.binary).length === 0) {\n    return { json: entry.json };\n  }\n\n  return entry;\n});"
      }
    },
    {
      "id": "7a",
      "name": "Email - Send Reminder",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [
        1780,
        140
      ],
      "parameters": {
        "fromEmail": "scottbrown@boardmad.com",
        "toEmail": "={{$json.owner_email}}",
        "subject": "={{$json.subject}}",
        "text": "={{$json.text_body}}",
        "html": "={{$json.html_body}}"
      },
      "notesInFlow": true,
      "notes": "Attach your SMTP credentials to this node after import."
    },
    {
      "id": "7b",
      "name": "Email - Send Overdue Warning",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [
        1780,
        300
      ],
      "parameters": {
        "fromEmail": "scottbrown@boardmad.com",
        "toEmail": "={{$json.owner_email}}",
        "subject": "={{$json.subject}}",
        "text": "={{$json.text_body}}",
        "html": "={{$json.html_body}}"
      },
      "notesInFlow": true,
      "notes": "Attach your SMTP credentials to this node after import."
    },
    {
      "id": "7c",
      "name": "Email - Send Escalation Notice",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [
        2780,
        460
      ],
      "parameters": {
        "fromEmail": "scottbrown@boardmad.com",
        "toEmail": "={{$json.escalation_contact_email}}",
        "subject": "={{$json.subject}}",
        "text": "={{$json.text_body}}",
        "html": "={{$json.html_body}}",
        "attachments": "={{Object.keys($binary || {}).join(',')}}"
      },
      "notesInFlow": true,
      "notes": "Attach your SMTP credentials to this node after import. Informational only \u2014 no check-in link is sent to the escalation contact."
    },
    {
      "id": "8",
      "name": "HTTP - Mark Event Delivered",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2040,
        300
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000,
      "parameters": {
        "method": "POST",
        "url": "https://continuity.boardmad.com/heartbeat-events/{{ $json.event_id }}/delivered",
        "options": {
          "timeout": 30000
        }
      }
    },
    {
      "id": "9",
      "name": "Code - Execution Summary",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2300,
        300
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "return [{\n  json: {\n    workflow: 'Continuity MVP - Reminder Dispatch',\n    event_id: $json.id,\n    heartbeat_id: $json.heartbeat_id,\n    delivered_at: $json.delivered_at,\n    status: 'delivered'\n  }\n}];"
      }
    }
  ],
