{
  "name": "Continuity MVP - Reminder Dispatch",
  "active": false,
  "nodes": [
    {
      "id": "1",
      "name": "Trigger - Every 5 Minutes",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        240,
        300
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 5
            }
          ]
        }
      }
    },
    {
      "id": "2",
      "name": "HTTP - Evaluate Due Heartbeats",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        500,
        300
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000,
      "parameters": {
        "method": "POST",
        "url": "https://continuity.boardmad.com/heartbeat-events/evaluate-due",
        "options": {
          "timeout": 30000
        }
      }
    },
    {
      "id": "3",
      "name": "HTTP - List Pending Events",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        760,
        300
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000,
      "parameters": {
        "method": "GET",
        "url": "https://continuity.boardmad.com/heartbeat-events/pending",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "limit",
              "value": "={{$env.CONTINUITY_PENDING_LIMIT || 100}}"
            }
          ]
        },
        "options": {
          "timeout": 30000
        }
      }
    },
    {
      "id": "4",
      "name": "Code - Expand Event Array",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1020,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const items = $input.all();\nconst expanded = [];\n\nfor (const item of items) {\n  if (Array.isArray(item.json)) {\n    for (const event of item.json) {\n      expanded.push({ json: event });\n    }\n  } else {\n    expanded.push({ json: item.json });\n  }\n}\n\nreturn expanded;"
      }
    },
    {
      "id": "5",
      "name": "Switch - Route By Event Type",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3.2,
      "position": [
        1260,
        300
      ],
      "parameters": {
        "mode": "rules",
        "rules": {
          "values": [
            {
              "conditions": {
                "conditions": [
                  {
                    "leftValue": "={{$json.event_type}}",
                    "rightValue": "reminder_due",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "reminder_due"
            },
            {
              "conditions": {
                "conditions": [
                  {
                    "leftValue": "={{$json.event_type}}",
                    "rightValue": "overdue",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "overdue"
            },
            {
              "conditions": {
                "conditions": [
                  {
                    "leftValue": "={{$json.event_type}}",
                    "rightValue": "escalation_due",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "escalation_due"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "6a",
      "name": "HTTP - Prepare Reminder Payload",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1520,
        140
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000,
      "parameters": {
        "method": "POST",
        "url": "https://continuity.boardmad.com/heartbeat-events/{{ $json.id }}/prepare-reminder",
        "options": {
          "timeout": 30000
        }
      }
    },
    {
      "id": "6b",
      "name": "HTTP - Prepare Overdue-Warning Payload",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1520,
        300
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000,
      "parameters": {
        "method": "POST",
        "url": "https://continuity.boardmad.com/heartbeat-events/{{ $json.id }}/prepare-overdue",
        "options": {
          "timeout": 30000
        }
      }
    },
    {
      "id": "6c",
      "name": "HTTP - Prepare Escalation Payload",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1520,
        460
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000,
      "parameters": {
        "method": "POST",
        "url": "https://continuity.boardmad.com/heartbeat-events/{{ $json.id }}/prepare-escalation",
        "options": {
          "timeout": 30000
        }
      }
    },
    {
      "id": "7a",
      "name": "Email - Send Reminder",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [
        1780,
        140
      ],
      "parameters": {
        "fromEmail": "scottbrown@boardmad.com",
        "toEmail": "={{$json.owner_email}}",
        "subject": "={{$json.subject}}",
        "text": "={{$json.text_body}}",
        "html": "={{$json.html_body}}"
      },
      "notesInFlow": true,
      "notes": "Attach your SMTP credentials to this node after import."
    },
    {
      "id": "7b",
      "name": "Email - Send Overdue Warning",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [
        1780,
        300
      ],
      "parameters": {
        "fromEmail": "scottbrown@boardmad.com",
        "toEmail": "={{$json.owner_email}}",
        "subject": "={{$json.subject}}",
        "text": "={{$json.text_body}}",
        "html": "={{$json.html_body}}"
      },
      "notesInFlow": true,
      "notes": "Attach your SMTP credentials to this node after import."
    },
    {
      "id": "7c",
      "name": "Email - Send Escalation Notice",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [
        1780,
        460
      ],
      "parameters": {
        "fromEmail": "scottbrown@boardmad.com",
        "toEmail": "={{$json.escalation_contact_email}}",
        "subject": "={{$json.subject}}",
        "text": "={{$json.text_body}}",
        "html": "={{$json.html_body}}"
      },
      "notesInFlow": true,
      "notes": "Attach your SMTP credentials to this node after import. Informational only \u2014 no check-in link is sent to the escalation contact."
    },
    {
      "id": "8",
      "name": "HTTP - Mark Event Delivered",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2040,
        300
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000,
      "parameters": {
        "method": "POST",
        "url": "https://continuity.boardmad.com/heartbeat-events/{{ $('Code - Expand Event Array').item.json.id }}/delivered",
        "options": {
          "timeout": 30000
        }
      }
    },
    {
      "id": "9",
      "name": "Code - Execution Summary",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2300,
        300
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "return [{\n  json: {\n    workflow: 'Continuity MVP - Reminder Dispatch',\n    event_id: $json.id,\n    heartbeat_id: $json.heartbeat_id,\n    delivered_at: $json.delivered_at,\n    status: 'delivered'\n  }\n}];"
      }
    }
  ],
  "connections": {
    "Trigger - Every 5 Minutes": {
      "main": [
        [
          {
            "node": "HTTP - Evaluate Due Heartbeats",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "HTTP - Evaluate Due Heartbeats": {
      "main": [
        [
          {
            "node": "HTTP - List Pending Events",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "HTTP - List Pending Events": {
      "main": [
        [
          {
            "node": "Code - Expand Event Array",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Code - Expand Event Array": {
      "main": [
        [
          {
            "node": "Switch - Route By Event Type",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Switch - Route By Event Type": {
      "main": [
        [
          {
            "node": "HTTP - Prepare Reminder Payload",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "HTTP - Prepare Overdue-Warning Payload",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "HTTP - Prepare Escalation Payload",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "HTTP - Prepare Reminder Payload": {
      "main": [
        [
          {
            "node": "Email - Send Reminder",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "HTTP - Prepare Overdue-Warning Payload": {
      "main": [
        [
          {
            "node": "Email - Send Overdue Warning",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "HTTP - Prepare Escalation Payload": {
      "main": [
        [
          {
            "node": "Email - Send Escalation Notice",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Email - Send Reminder": {
      "main": [
        [
          {
            "node": "HTTP - Mark Event Delivered",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Email - Send Overdue Warning": {
      "main": [
        [
          {
            "node": "HTTP - Mark Event Delivered",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Email - Send Escalation Notice": {
      "main": [
        [
          {
            "node": "HTTP - Mark Event Delivered",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "HTTP - Mark Event Delivered": {
      "main": [
        [
          {
            "node": "Code - Execution Summary",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "pinData": {},
  "staticData": null,
  "tags": []
