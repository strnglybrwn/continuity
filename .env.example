CONTINUITY_APPLICATION_NAME=Digital Continuity
CONTINUITY_APPLICATION_VERSION=0.1.0
CONTINUITY_ENVIRONMENT=development

CONTINUITY_DATABASE_HOST=postgres
CONTINUITY_DATABASE_PORT=5432
CONTINUITY_DATABASE_NAME=continuity
CONTINUITY_DATABASE_USER=continuity

# Local development only:
CONTINUITY_DATABASE_PASSWORD=replace-me

# Docker Swarm production:
# CONTINUITY_DATABASE_PASSWORD_FILE=/run/secrets/continuity_postgres_password
